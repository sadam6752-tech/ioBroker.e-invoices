{
  "name": "iobroker.e-invoices",
  "version": "0.8.2",
  "description": "Create ZUGFeRD e-invoices as PWA with PDF, Excel export and backup",
  "author": {
    "name": "alex",
    "email": "sadam6752@gmail.com"
  },
  "contributors": [],
  "homepage": "https://github.com/sadam6752-tech/ioBroker.e-invoices",
  "license": "MIT",
  "keywords": [
    "e-invoice",
    "zugferd",
    "xrechnung",
    "pdf",
    "excel",
    "backup",
    "pwa",
    "ioBroker"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sadam6752-tech/ioBroker.e-invoices.git"
  },
  "engines": {
    "node": ">= 22"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "@stackforge-eu/factur-x": "^1.4.2",
    "better-sqlite3": "^12.11.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/dev-server": "^0.8.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.2.2",
    "@playwright/test": "^1.63.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/iobroker": "npm:@iobroker/types@^7.2.3",
    "@types/node": "^22.20.4",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.1",
    "rimraf": "^6.1.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "main": "build/main.js",
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).{json,json5}",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "build/",
    "www/",
    "assets/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "rimraf build",
    "build": "build-adapter ts && npm run build:pwa",
    "build:pwa": "rimraf www && npm --prefix src-www install --no-audit --no-fund && npm --prefix src-www run build",
    "watch": "build-adapter ts --watch",
    "prebuild:ts": "rimraf build",
    "build:ts": "build-adapter ts",
    "watch:ts": "build-adapter ts --watch",
    "test:ts": "mocha --config test/mocharc.custom.json src/**/*.test.ts",
    "test:api": "mocha --config test/mocharc.custom.json test/api-server.test.ts --exit",
    "test:pwa": "mocha --config test/mocharc.custom.json test/pwa.test.ts --exit",
    "test:i18n": "mocha --config test/mocharc.custom.json test/i18n.test.ts --exit",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test:e2e": "playwright test",
    "test": "npm run test:ts && npm run test:api && npm run test:pwa && npm run test:i18n && npm run test:package",
    "check": "tsc --noEmit && npm run check:e2e",
    "check:e2e": "tsc -p test/e2e/tsconfig.json",
    "lint": "eslint -c eslint.config.mjs .",
    "translate": "translate-adapter",
    "release": "release-script",
    "dev-server": "dev-server"
  },
  "bugs": {
    "url": "https://github.com/sadam6752-tech/ioBroker.e-invoices/issues"
  },
  "readmeFilename": "README.md"
}
