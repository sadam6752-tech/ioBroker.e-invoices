// Type checking of the browser tests: they run in the browser, so they need the DOM types the adapter (a Node
// program) does not have. `npm run check:e2e` and ESLint both pick this file up for `test/e2e/`.
// `playwright.config.ts` itself stays in the root tsconfig (it needs no DOM types).
{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["node"]
	},
	"include": ["**/*.ts"],
	// the parent excludes `test/e2e/**` (the browser tests are not part of the adapter programme); this config
	// exists exactly for these files, so the exclusion is dropped here
	"exclude": []
}
