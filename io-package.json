			"native": {}
		},
		{
			"_id": "control",
			"type": "channel",
			"common": {
				"name": "Control commands"
			},
			"native": {}
		},
		{
			"_id": "control.createDraft",
			"type": "state",
			"common": {
				"role": "button",
				"name": "Create empty draft",
