		{
			"_id": "info.lastIssuedAt",
			"type": "state",
			"common": {
				"role": "text",
				"name": "Last issue timestamp",
				"type": "string",
				"read": true,
				"write": false
			},
			"native": {}
		},
		{
			"_id": "info.dbVersion",
			"type": "state",
			"common": {
				"role": "value",
				"name": "Database schema version",
				"type": "number",
				"read": true,
				"write": false,
				"def": 0
			},
			"native": {}
		},
		{
			"_id": "info.lastBackup",
			"type": "state",
			"common": {
				"role": "text",
				"name": "Last backup filename",
				"type": "string",
				"read": true,
				"write": false
