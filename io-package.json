				"read": false,
				"write": true,
				"def": false
			},
			"native": {}
		},
		{
			"_id": "control.refresh",
			"type": "state",
			"common": {
				"role": "button",
				"name": "Refresh stats and status file",
				"type": "boolean",
				"read": false,
				"write": true,
				"def": false
			},
			"native": {}
		},
		{
			"_id": "control.backup",
			"type": "state",
			"common": {
				"role": "button",
				"name": "Create backup now",
