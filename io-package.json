				"read": true,
				"write": true
			},
			"native": {}
		},
		{
			"_id": "control.restore",
			"type": "state",
			"common": {
				"role": "button",
				"name": "Restore backup from restoreId",
				"type": "boolean",
				"read": false,
				"write": true,
				"def": false
			},
			"native": {}
		}
