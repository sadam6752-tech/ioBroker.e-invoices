				"write": false,
				"def": 0
			},
			"native": {}
		},
		{
			"_id": "info.draftCount",
			"type": "state",
			"common": {
				"role": "value",
				"name": "Draft invoices",
				"type": "number",
				"read": true,
				"write": false,
				"def": 0
			},
			"native": {}
		},
		{
			"_id": "info.issuedCount",
			"type": "state",
			"common": {
				"role": "value",
				"name": "Issued invoices",
