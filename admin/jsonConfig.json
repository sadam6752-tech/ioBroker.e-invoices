{
	"i18n": true,
	"type": "tabs",
	"items": {
		"server": {
			"type": "panel",
			"label": "Server",
			"items": {
				"port": {
					"type": "number",
					"label": "API port",
					"min": 1024,
					"max": 65535,
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 6,
					"lg": 4,
					"xl": 4
				},
				"bind": {
					"type": "ip",
					"listenOnAllPorts": true,
					"label": "Bind address",
					"help": "127.0.0.1 = only this machine, 0.0.0.0 = all interfaces",
					"newLine": false,
					"xs": 12,
					"sm": 12,
					"md": 6,
					"lg": 4,
					"xl": 4
				},
				"storageMount": {
					"type": "text",
					"label": "Storage mount name",
					"help": "empty = own data directory; otherwise an existing ioBroker file mount, e.g. e-invoices",
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 6,
					"lg": 4,
					"xl": 4
				},
				"backupIntervalMinutes": {
					"type": "number",
					"label": "Backup interval in minutes",
					"help": "0 = off, otherwise an automatic backup into the storage mount",
					"min": 0,
					"max": 10080,
					"newLine": false,
					"xs": 12,
					"sm": 12,
					"md": 6,
					"lg": 4,
					"xl": 4
				},
				"backupKeep": {
					"type": "number",
					"label": "Automatic backups to keep",
					"help": "Older automatic backups are deleted, 0 = keep all. Manual backups are never deleted.",
					"min": 0,
					"max": 365,
					"newLine": false,
					"xs": 12,
					"sm": 12,
					"md": 6,
					"lg": 4,
					"xl": 4
				},
				"reminderCheckHours": {
					"type": "number",
					"label": "Dunning check interval in hours",
					"help": "0 = off. The adapter only counts overdue invoices into info.overdue*, it never sends mails by itself.",
					"min": 0,
					"max": 168,
					"newLine": false,
					"xs": 12,
					"sm": 12,
					"md": 6,
					"lg": 4,
					"xl": 4
				},
				"pwaLanguage": {
					"type": "select",
					"label": "Web app language",
					"help": "auto = language of the browser; German and English are available",
					"options": [
						{ "label": "auto", "value": "auto" },
						{ "label": "Deutsch", "value": "de" },
						{ "label": "English", "value": "en" }
					],
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 6,
					"lg": 4,
					"xl": 4
				},
				"secure": {
					"type": "checkbox",
					"label": "Use HTTPS",
					"help": "the web app answers over HTTPS with a certificate of the ioBroker certificate collection (needed to install it on an iPhone or iPad); without a working certificate the web app stays unavailable",
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 6,
					"lg": 4,
					"xl": 4
				},
				"certPublic": {
					"type": "certificate",
					"certType": "public",
					"label": "Public certificate",
					"hidden": "!data.secure",
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 4,
					"lg": 4,
					"xl": 4
				},
				"certPrivate": {
					"type": "certificate",
					"certType": "private",
					"label": "Private key",
					"hidden": "!data.secure",
					"xs": 12,
					"sm": 12,
					"md": 4,
					"lg": 4,
					"xl": 4
				},
				"certChained": {
					"type": "certificate",
					"certType": "chained",
					"label": "Certificate chain (optional)",
					"hidden": "!data.secure",
					"xs": 12,
					"sm": 12,
					"md": 4,
					"lg": 4,
					"xl": 4
				},
				"authToken": {
					"type": "password",
					"label": "API token (optional)",
					"help": "Empty means no authentication (LAN trust)",
					"repeat": false,
					"visible": true,
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 12,
					"lg": 8,
					"xl": 8
				}
			}
		},
		"company": {
			"type": "panel",
			"label": "Company master data",
			"items": {
				"_companyHint": {
					"type": "staticText",
					"text": "These values fill the default company profile on every start. The PWA page “Firma” can still add further profiles; whatever is edited there is kept.",
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 12,
					"lg": 12,
					"xl": 12
				},
				"companyName": {
					"type": "text",
					"label": "Company name",
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 6,
					"lg": 4,
					"xl": 4
				},
				"companyStreet": {
					"type": "text",
					"label": "Company street",
					"newLine": false,
					"xs": 12,
					"sm": 12,
					"md": 6,
					"lg": 4,
					"xl": 4
				},
				"companyZip": {
					"type": "text",
					"label": "Company zip code",
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 3,
					"lg": 2,
					"xl": 2
				},
				"companyCity": {
					"type": "text",
					"label": "Company city",
					"newLine": false,
					"xs": 12,
					"sm": 12,
					"md": 3,
					"lg": 3,
					"xl": 3
				},
				"companyCountry": {
					"type": "text",
					"label": "Company country",
					"default": "DE",
					"newLine": false,
					"xs": 12,
					"sm": 12,
					"md": 3,
					"lg": 3,
					"xl": 3
				},
				"vatId": {
					"type": "text",
					"label": "VAT ID (USt-IdNr.)",
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 4,
					"lg": 3,
					"xl": 3
				},
				"taxNumber": {
					"type": "text",
					"label": "Tax number (Steuernr.)",
					"newLine": false,
					"xs": 12,
					"sm": 12,
					"md": 4,
					"lg": 3,
					"xl": 3
				},
				"companyEmail": {
					"type": "text",
					"label": "Company e-mail",
					"newLine": false,
					"xs": 12,
					"sm": 12,
					"md": 4,
					"lg": 3,
					"xl": 3
				},
				"iban": {
					"type": "text",
					"label": "IBAN",
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 4,
					"lg": 3,
					"xl": 3
				},
				"bic": {
					"type": "text",
					"label": "BIC",
					"newLine": false,
					"xs": 12,
					"sm": 12,
					"md": 4,
					"lg": 3,
					"xl": 3
				},
				"website": {
					"type": "text",
					"label": "Website",
					"newLine": false,
					"xs": 12,
					"sm": 12,
					"md": 4,
					"lg": 3,
					"xl": 3
				}
			}
		},
		"invoicing": {
			"type": "panel",
			"label": "Invoicing defaults",
			"items": {
				"numberFormat": {
					"type": "text",
					"label": "Invoice number format",
					"help": "Tokens: {YYYY} year, {EMPLOYEE} employee code, {SEQ} sequence. {SEQ} is required.",
					"default": "{YYYY}-{EMPLOYEE}-{SEQ}",
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 6,
					"lg": 5,
					"xl": 5
				},
				"quoteNumberFormat": {
					"type": "text",
					"label": "Quotation number format",
					"help": "Own number circle, used only for quotations. Tokens: {YYYY} year, {EMPLOYEE} employee code, {SEQ} sequence. {SEQ} is required.",
					"default": "A-{YYYY}-{EMPLOYEE}-{SEQ}",
					"newLine": false,
					"xs": 12,
					"sm": 12,
					"md": 6,
					"lg": 5,
					"xl": 5
				},
				"defaultVatRate": {
					"type": "select",
					"label": "Default VAT rate",
					"options": [
						{ "label": "19 %", "value": 19 },
						{ "label": "7 %", "value": 7 },
						{ "label": "0 %", "value": 0 }
					],
					"default": 19,
					"newLine": false,
					"xs": 12,
					"sm": 12,
					"md": 3,
					"lg": 3,
					"xl": 3
				},
				"defaultProfile": {
					"type": "select",
					"label": "Default invoice format",
					"help": "ZUGFeRD is a PDF with the invoice data inside. XRechnung is the XML file alone, for public-sector customers (it needs their Leitweg-ID). The wizard can change it per document.",
					"options": [
						{ "label": "ZUGFeRD (PDF + XML)", "value": "EN16931" },
						{ "label": "XRechnung (XML)", "value": "XRECHNUNG" }
					],
					"default": "EN16931",
					"newLine": false,
					"xs": 12,
					"sm": 12,
					"md": 9,
					"lg": 4,
					"xl": 4
				},
				"defaultPaymentTerms": {
					"type": "select",
					"label": "Default payment terms",
					"help": "prefilled for new invoices; the wizard offers these as a list plus free text",
					"options": [
						{ "label": "none", "value": "" },
						{ "label": "Der Rechnungsbetrag ist sofort ohne Abzug fällig.", "value": "Der Rechnungsbetrag ist sofort ohne Abzug fällig." },
						{ "label": "Bitte überweisen Sie den o.g. Betrag innerhalb von 14 Tagen auf unser Konto.", "value": "Bitte überweisen Sie den o.g. Betrag innerhalb von 14 Tagen auf unser Konto." },
						{ "label": "Zahlbar innerhalb von 30 Tagen nach Rechnungsdatum ohne Abzug.", "value": "Zahlbar innerhalb von 30 Tagen nach Rechnungsdatum ohne Abzug." }
					],
					"default": "",
					"newLine": true,
					"xs": 12,
					"sm": 12,
					"md": 12,
					"lg": 7,
					"xl": 7
				}
			}
		},
		"datev": {
			"type": "panel",
			"label": "DATEV",
			"items": {
				"_datevHint": {
					"type": "staticText",
					"text": "The DATEV export (Buchungsstapel) needs the numbers of your tax advisor. Without advisor and client number the web app offers no DATEV file. Empty accounts take the default of the chart of accounts.",
					"xs": 12,
					"sm": 12,
					"md": 12,
					"lg": 12,
					"xl": 12
				},
				"datevConsultant": {
					"type": "text",
					"label": "Advisor number (Beraternummer)",
					"xs": 12,
					"sm": 12,
					"md": 4,
					"lg": 4,
					"xl": 4,
					"newLine": true,
					"help": "1001–9999999, from your tax advisor"
				},
				"datevClient": {
					"type": "text",
					"label": "Client number (Mandantennummer)",
					"xs": 12,
					"sm": 12,
					"md": 4,
					"lg": 4,
					"xl": 4,
					"help": "1–99999, from your tax advisor"
				},
				"datevChart": {
					"type": "select",
					"label": "Chart of accounts",
					"xs": 12,
					"sm": 12,
					"md": 4,
					"lg": 4,
					"xl": 4,
					"options": [
						{
							"label": "SKR03",
							"value": "SKR03"
						},
						{
							"label": "SKR04",
							"value": "SKR04"
						}
					],
					"default": "SKR03"
				},
				"datevAccountLength": {
					"type": "number",
					"label": "Account length (Sachkontenlänge)",
					"xs": 12,
					"sm": 12,
					"md": 4,
					"lg": 4,
					"xl": 4,
					"min": 4,
					"max": 8,
					"default": 4,
					"newLine": true
				},
				"datevFiscalYearStart": {
					"type": "number",
					"label": "First month of the fiscal year",
					"xs": 12,
					"sm": 12,
					"md": 4,
					"lg": 4,
					"xl": 4,
					"min": 1,
					"max": 12,
					"default": 1
				},
				"datevDebtor": {
					"type": "text",
					"label": "Debtor account (collective)",
					"xs": 12,
					"sm": 12,
					"md": 4,
					"lg": 4,
					"xl": 4,
					"help": "empty = 10000 (with account length 4)"
				},
				"datevRevenue19": {
					"type": "text",
					"label": "Revenue account 19 %",
					"xs": 12,
					"sm": 12,
					"md": 4,
					"lg": 4,
					"xl": 4,
					"help": "empty = SKR03 8400 / SKR04 4400",
					"newLine": true
				},
				"datevRevenue7": {
					"type": "text",
					"label": "Revenue account 7 %",
					"xs": 12,
					"sm": 12,
					"md": 4,
					"lg": 4,
					"xl": 4,
					"help": "empty = SKR03 8300 / SKR04 4300"
				},
				"datevRevenue0": {
					"type": "text",
					"label": "Revenue account 0 % (tax-exempt)",
					"xs": 12,
					"sm": 12,
					"md": 4,
					"lg": 4,
					"xl": 4,
					"help": "empty = SKR03 8100 / SKR04 4100"
				}
			}
		}
	}
}
